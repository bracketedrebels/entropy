{
  "name": "@neui-tools/leaving",
  "version": "0.0.0",
  "description": "CSS-driven exit transitions for React, Tailwind CSS and Vite.",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bracketedrebels/entropy.git",
    "directory": "design-system/leaving"
  },
  "exports": {
    ".": {
      "types": "./vite.d.mts",
      "import": "./vite.mjs"
    },
    "./vite": {
      "types": "./vite.d.mts",
      "import": "./vite.mjs"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "files": [
    "vite.mjs",
    "vite.d.mts",
    "transform.mjs",
    "styles.mjs",
    "tailwind.css",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "7.29.15",
    "magic-string": "1.4.5",
    "postcss": "8.5.33",
    "tinyglobby": "0.2.17"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "tailwindcss": "^4.0.0",
    "vite": "^7.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "~5.9.3"
  }
}
