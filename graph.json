    {
      "name": "../../modules/stdlib.ent",
      "text": "; Stream — тип stdlib, с RxJS Observable в качестве runtime M1.\n(module std\n  (native-type Stream (a))\n  (native-type Result (e a))\n  (native-type JSON ())\n  (native-type Schema (a))\n  (native-type ValidationErrors ())\n  (native function keep (forall (a) (fn (a) a)) (nodejs core.identity))\n  (native function join (fn (String (Vector String)) String) (nodejs text.join))\n  (native function map\n    (forall (a b) (fn ((fn (a) b) (Stream a)) (Stream b))) (nodejs rx.map))\n  (native function switchMap\n    (forall (a b) (fn ((fn (a) (Stream b)) (Stream a)) (Stream b))) (nodejs rx.switchMap))\n  (native source constant (forall (a) (fn (a) (Stream a))) (nodejs rx.of))\n  (native function fold\n    (forall (e a b) (fn ((fn (e) b) (fn (a) b) (Result e a)) b)) (nodejs result.fold))\n  (native function validate\n    (forall (a) (fn ((Schema a) JSON) (Result ValidationErrors a))) (nodejs json.validate))\n  (native function encode (forall (a) (fn (a) JSON)) (nodejs json.encode))\n)\n",
      "path": "modules/stdlib.ent"
    },
    {
      "name": "../../modules/http.ent",
      "text": "(module http\n  (native-type Request (a))\n  (native-type RawHTTP ())\n  (native-type Reply ())\n  (native-type Response ())\n  (native source requests (fn () (Stream (Request RawHTTP))) (nodejs http.requests))\n  (native sink responses (fn ((Stream Response)) Unit) (nodejs http.responses))\n  (native function readQuery (fn ((Request RawHTTP)) (Request JSON)) (nodejs http.readQuery))\n  (native function getPayload (forall (a) (fn ((Request a)) a)) (nodejs http.getPayload))\n  (native function makeResponse (forall (a) (fn ((Request a) Reply) Response)) (nodejs http.makeResponse))\n  (native function makeOk (fn (JSON) Reply) (nodejs http.makeOk))\n  (native function makeBadRequest (fn (ValidationErrors) Reply) (nodejs http.makeBadRequest))\n)\n",
      "path": "modules/http.ent"
    },
    {
      "name": "full-name.ent",
      "text": "; Здесь нет объявлений типов. person — значение схемы в config space.\n(module fullname\n  (schema person \"person.schema.json\")\n\n  (graph source requests (inputs)\n    (output (call std.map http.readQuery (call http.requests))))\n\n  (graph sink responses (inputs replies)\n    (output (call http.responses replies)))\n\n  (graph function formatName (inputs person)\n    (node first (field person first))\n    (node last (field person last))\n    (node joined (call std.join \" \" (vector first last)))\n    (output (tuple (full joined))))\n\n  (graph function prepareSuccess (inputs person)\n    (output (call http.makeOk (call std.encode (call formatName person)))))\n\n  (graph function prepareResponse (inputs request)\n    (node result (call std.validate person (call http.getPayload request)))\n    (node content (call std.fold http.makeBadRequest prepareSuccess result))\n    (output (call http.makeResponse request content)))\n\n  (graph sink main (inputs)\n    (node incoming (call requests))\n    (node outgoing (call std.map prepareResponse incoming))\n    (output (call responses outgoing)))\n\n  (entry main)\n)\n",
      "path": "examples/full-name/full-name.ent"
    }
  ],
